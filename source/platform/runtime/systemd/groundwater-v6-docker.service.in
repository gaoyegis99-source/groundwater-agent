[Unit]
Description=Groundwater V6 isolated rootless Docker daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=@ENV_FILE@
RuntimeDirectory=groundwater-v6
RuntimeDirectoryMode=0700
ExecStart=@LAUNCHER@ daemon
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=default.target
