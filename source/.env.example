# Groundwater v12 research profile parameters.
#
# Copy this file to .env and edit only the copy:
#   cp .env.example .env
# Docker Compose reads .env from the repository root. The file is ignored by Git.
# Never put API keys in this file. Keys are mounted from PLATFORM_SECRETS_DIR.

# --- Public Gateway ---------------------------------------------------------
# The research Gateway remains loopback-only by default.
PLATFORM_GATEWAY_BIND_IP=127.0.0.1
PLATFORM_GATEWAY_PORT=28186

# --- Agent Provider ---------------------------------------------------------
# Current DeepSeek development profile. Provider/model/protocol must be changed
# as one compatible set; do not configure cross-provider fallback here.
PLATFORM_AGENT_PROVIDER=deepseek
PLATFORM_AGENT_PROTOCOL=responses
PLATFORM_AGENT_BASE_URL=https://api.deepseek.com
PLATFORM_AGENT_STANDBY_BASE_URL=
PLATFORM_AGENT_HEALTH_PATH=/models
PLATFORM_AGENT_MODEL=deepseek-flash
PLATFORM_AGENT_CONTEXT_WINDOW_TOKENS=131072
PLATFORM_AGENT_MAX_OUTPUT_TOKENS=4096
PLATFORM_AGENT_REQUEST_TIMEOUT_SECONDS=180
PLATFORM_AGENT_SEGMENT_TIMEOUT_SECONDS=600
PLATFORM_AGENT_PREVIEW_ENABLED=true

# --- Intent Router ----------------------------------------------------------
# The Router is configured independently even when it uses the same Provider.
PLATFORM_INTENT_ROUTER_PROVIDER=deepseek
PLATFORM_INTENT_ROUTER_PROTOCOL=responses
PLATFORM_INTENT_ROUTER_BASE_URL=https://api.deepseek.com
PLATFORM_INTENT_ROUTER_STANDBY_BASE_URL=
PLATFORM_INTENT_ROUTER_HEALTH_PATH=/models
PLATFORM_INTENT_ROUTER_MODEL=deepseek-flash
PLATFORM_INTENT_ROUTER_CONTEXT_WINDOW_TOKENS=131072
PLATFORM_INTENT_ROUTER_MAX_OUTPUT_TOKENS=1024
PLATFORM_INTENT_ROUTER_REQUEST_TIMEOUT_SECONDS=180
PLATFORM_INTENT_ROUTER_SEGMENT_TIMEOUT_SECONDS=600

# --- Knowledge / Embedding --------------------------------------------------
# The client disables inherited HTTP proxy settings for this LAN endpoint.
PLATFORM_EMBEDDING_BASE_URL=http://192.168.167.89:38173
PLATFORM_EMBEDDING_HEALTH_PATH=/health
KNOWLEDGE_VECTOR_SEARCH=exact

# --- Readiness --------------------------------------------------------------
PLATFORM_READINESS_TIMEOUT_SECONDS=5
PLATFORM_READINESS_SUCCESS_CACHE_SECONDS=15
PLATFORM_READINESS_FAILURE_CACHE_SECONDS=5

# --- Executor / managed third-party egress ---------------------------------
# Capacity values are frozen into executor-config.v8 and the assembly lock.
EXECUTOR_REMOTE_HTTP_SLOTS=2
EXECUTOR_REMOTE_HTTP_MEMORY_BYTES=2147483648
# HTTPS only. The parsed URL host must exactly equal the separate allowlist value.
GROUNDWATER_SUSTAINABILITY_BASE_URL=https://sustainability.example.invalid
GROUNDWATER_SUSTAINABILITY_ALLOWED_HOST=sustainability.example.invalid

# --- Secret mount root ------------------------------------------------------
# Required absolute path outside this Git repository. The directory contains
# agent-api-key, intent-router-api-key, data-db-password and
# knowledge-db-password, groundwater-sustainability-api-key and
# groundwater-sustainability-ca-bundle; values never belong in .env.
PLATFORM_SECRETS_DIR=/absolute/path/outside/repository/groundwater-v12-secrets
