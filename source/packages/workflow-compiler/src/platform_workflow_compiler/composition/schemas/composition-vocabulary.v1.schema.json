{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.platform.local/workflow-composition/composition-vocabulary.v1.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "composition-vocabulary.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "quantities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "crs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "boolean"
          }
        },
        "required": [
          "metric"
        ],
        "additionalProperties": false
      }
    },
    "units": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "offset": {
            "type": "number"
          }
        },
        "required": [
          "dimension",
          "scale",
          "offset"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "quantities",
    "crs",
    "units"
  ],
  "additionalProperties": false
}
