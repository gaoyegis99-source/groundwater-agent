{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.platform.local/workflow-composition/operator-manifest.v2.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "operator-manifest.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "definitionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "implementationRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "runtime": {
      "enum": [
        "native",
        "qgis",
        "remote_http"
      ]
    },
    "remoteBinding": {
      "type": "object",
      "properties": {
        "serviceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "operationType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      },
      "required": [
        "serviceId",
        "operationType"
      ],
      "additionalProperties": false
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "memoryLimitBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "composition-types.v1.schema.json#/$defs/port"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "composition-types.v1.schema.json#/$defs/port"
      },
      "minItems": 1
    },
    "parametersSchema": {
      "type": "object"
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "composition-types.v1.schema.json#/$defs/identity"
      },
      "minItems": 1
    },
    "classification": {
      "type": "object",
      "properties": {
        "reuseScope": {
          "enum": [
            "generic",
            "domain",
            "scenario"
          ]
        },
        "providerKind": {
          "enum": [
            "platform",
            "external"
          ]
        },
        "methodId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "domainTags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "reuseScope",
        "providerKind"
      ],
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "applicability": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "portSemantics": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "requires": {
            "$ref": "composition-types.v1.schema.json#/$defs/facts"
          },
          "requiredFacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "fieldBindings": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "parameter": {
                  "type": "string",
                  "minLength": 1
                },
                "requires": {
                  "type": "object",
                  "properties": {
                    "dtype": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantityKind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "minProperties": 1,
                  "additionalProperties": false
                }
              },
              "required": [
                "parameter"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "parameterPolicies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "allowedSources": {
            "type": "array",
            "items": {
              "$ref": "composition-types.v1.schema.json#/$defs/sourceKind"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "defaultPolicy": {
            "enum": [
              "none",
              "declared"
            ]
          },
          "allowNodeOutput": {
            "type": "boolean"
          },
          "impact": {
            "enum": [
              "engineering",
              "scientific"
            ]
          }
        },
        "required": [
          "allowedSources"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "composition-types.v1.schema.json#/$defs/check"
      }
    },
    "outputSemantics": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fixed": {
            "$ref": "composition-types.v1.schema.json#/$defs/facts"
          },
          "inherit": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "inputPort": {
                  "type": "string",
                  "minLength": 1
                },
                "facts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "inputPort",
                "facts"
              ],
              "additionalProperties": false
            }
          },
          "transform": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "enum": [
                    "parameterFact",
                    "convertUnit"
                  ]
                },
                "property": {
                  "type": "string",
                  "minLength": 1
                },
                "parameter": {
                  "type": "string",
                  "minLength": 1
                },
                "inputPort": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "rule",
                "property",
                "parameter"
              ],
              "additionalProperties": false
            }
          },
          "measured": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "executionPolicy": {
      "type": "object",
      "properties": {
        "sideEffect": {
          "enum": [
            "newArtifacts",
            "remoteJob"
          ]
        },
        "retry": {
          "enum": [
            "never",
            "idempotent",
            "coordinate"
          ]
        },
        "determinism": {
          "enum": [
            "bitwise",
            "tolerance",
            "nondeterministic"
          ]
        },
        "cacheable": {
          "type": "boolean"
        },
        "environmentRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "seedParameter": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "type": "object",
          "properties": {
            "absoluteTolerance": {
              "type": "number",
              "minimum": 0
            },
            "relativeTolerance": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "absoluteTolerance",
            "relativeTolerance"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sideEffect",
        "retry",
        "determinism"
      ],
      "additionalProperties": false
    },
    "conformanceEvidence": {
      "type": "object",
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "$ref": "composition-types.v1.schema.json#/$defs/identity"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "negative": {
          "type": "array",
          "items": {
            "$ref": "composition-types.v1.schema.json#/$defs/identity"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "positive",
        "negative",
        "scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "definitionDigest",
    "implementationRevision",
    "title",
    "description",
    "domain",
    "runtime",
    "timeoutSeconds",
    "memoryLimitBytes",
    "inputs",
    "outputs",
    "classification"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "remote_http"
          }
        }
      },
      "then": {
        "required": [
          "remoteBinding",
          "executionPolicy"
        ],
        "properties": {
          "classification": {
            "properties": {
              "providerKind": {
                "const": "external"
              }
            }
          },
          "executionPolicy": {
            "properties": {
              "sideEffect": {
                "const": "remoteJob"
              },
              "retry": {
                "enum": [
                  "never",
                  "coordinate"
                ]
              },
              "cacheable": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "remoteBinding"
          ]
        },
        "properties": {
          "executionPolicy": {
            "properties": {
              "sideEffect": {
                "const": "newArtifacts"
              },
              "retry": {
                "enum": [
                  "never",
                  "idempotent"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionPolicy": {
            "properties": {
              "determinism": {
                "const": "tolerance"
              }
            },
            "required": [
              "determinism"
            ]
          }
        },
        "required": [
          "executionPolicy"
        ]
      },
      "then": {
        "properties": {
          "executionPolicy": {
            "required": [
              "comparison"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionPolicy": {
            "properties": {
              "determinism": {
                "const": "nondeterministic"
              }
            },
            "required": [
              "determinism"
            ]
          }
        },
        "required": [
          "executionPolicy"
        ]
      },
      "then": {
        "properties": {
          "executionPolicy": {
            "properties": {
              "cacheable": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionPolicy": {
            "properties": {
              "cacheable": {
                "const": true
              }
            },
            "required": [
              "cacheable"
            ]
          }
        },
        "required": [
          "executionPolicy"
        ]
      },
      "then": {
        "required": [
          "conformanceEvidence"
        ]
      }
    }
  ]
}
