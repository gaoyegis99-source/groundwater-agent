{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operator-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "description",
    "domain",
    "tags",
    "runtime",
    "timeoutSeconds",
    "memoryLimitBytes",
    "inputs",
    "parametersSchema",
    "outputs",
    "errorCodes",
    "examples"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "enum": [
        "native",
        "qgis",
        "remote_http"
      ]
    },
    "remoteBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceId", "operationType"],
      "properties": {
        "serviceId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "operationType": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "memoryLimitBytes": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parametersSchema": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "artifact",
              "value"
            ]
          },
          "mediaTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "formats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "schema": {
            "type": "object"
          },
          "formatCases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inputPort",
                "inputFormats",
                "mediaType",
                "format"
              ],
              "properties": {
                "inputPort": {
                  "type": "string",
                  "minLength": 1
                },
                "inputFormats": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mediaType": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "parameterFormatCases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parameter",
                "values",
                "mediaType",
                "format"
              ],
              "properties": {
                "parameter": {
                  "type": "string",
                  "minLength": 1
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mediaType": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "artifact"
                }
              }
            },
            "then": {
              "required": [
                "mediaTypes",
                "formats"
              ]
            }
          }
        ]
      }
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
