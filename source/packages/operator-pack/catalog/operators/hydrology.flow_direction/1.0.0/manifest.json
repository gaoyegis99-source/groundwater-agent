{
  "description": "Calculates fixed-code D8 flow direction from an explicitly conditioned DEM.",
  "domain": "hydrology",
  "errorCodes": [
    "CRS_REQUIRED",
    "PROJECTED_CRS_REQUIRED",
    "BAND_INVALID",
    "DEM_NOT_CONDITIONED",
    "RASTER_INVALID"
  ],
  "examples": [
    {
      "clientRequestId": "example-hydrology-flow_direction",
      "inputs": {
        "dem": {
          "artifactId": "art_example_01"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "hydrology.flow_direction",
        "version": "1.0.0"
      },
      "parameters": {},
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "hydrology.flow_direction",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "cog",
        "geotiff"
      ],
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "dem",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "geotiff"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "flowDirection"
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {
      "band": {
        "default": 1,
        "minimum": 1,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "hydrology",
    "dem",
    "d8",
    "capability:flow_direction",
    "流向",
    "D8流向",
    "排水方向",
    "从处理过的 DEM 计算 D8 流向"
  ],
  "timeoutSeconds": 3600,
  "title": "D8 flow direction",
  "version": "1.0.0",
  "composition": {
    "portSemantics": {
      "dem": {
        "requires": {
          "valueKind": "dem"
        }
      }
    },
    "outputSemantics": {
      "flowDirection": {
        "fixed": {
          "valueKind": "d8-direction"
        },
        "inherit": [
          {
            "inputPort": "dem",
            "facts": [
              "crs",
              "grid"
            ]
          }
        ]
      }
    }
  }
}
