{
  "description": "Calculates fixed-code D8 flow direction from an explicitly conditioned DEM.",
  "domain": "hydrology",
  "errorCodes": [
    "CRS_REQUIRED",
    "PROJECTED_CRS_REQUIRED",
    "BAND_INVALID",
    "DEM_NOT_CONDITIONED",
    "RASTER_INVALID"
  ],
  "examples": [
    {
      "clientRequestId": "example-hydrology-flow_direction",
      "inputs": {
        "dem": {
          "artifactId": "art_example_01"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "hydrology.flow_direction",
        "version": "1.0.0"
      },
      "parameters": {},
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "hydrology.flow_direction",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "cog",
        "geotiff"
      ],
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "dem",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "cog",
        "geotiff"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "flowDirection"
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {
      "band": {
        "default": 1,
        "minimum": 1,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "hydrology",
    "dem",
    "d8"
  ],
  "timeoutSeconds": 3600,
  "title": "D8 flow direction",
  "version": "1.0.0"
}
