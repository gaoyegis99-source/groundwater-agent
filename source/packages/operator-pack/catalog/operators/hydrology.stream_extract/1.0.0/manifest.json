        "type": "integer"
      }
    },
    "required": [
      "minimumContributingCells"
    ],
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "hydrology",
    "stream",
    "accumulation"
  ],
  "timeoutSeconds": 3600,
  "title": "Extract stream raster",
  "version": "1.0.0"
}
