{
  "description": "Creates a binary stream mask using a minimum contributing-cell threshold.",
  "domain": "hydrology",
  "errorCodes": [
    "CRS_REQUIRED",
    "PROJECTED_CRS_REQUIRED",
    "ACCUMULATION_INVALID",
    "RASTER_INVALID"
  ],
  "examples": [
    {
      "clientRequestId": "example-hydrology-stream_extract",
      "inputs": {
        "accumulation": {
          "artifactId": "art_example_01"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "hydrology.stream_extract",
        "version": "1.0.0"
      },
      "parameters": {
        "minimumContributingCells": 1
      },
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "hydrology.stream_extract",
  "inputs": [
    {
      "cardinality": "one",
