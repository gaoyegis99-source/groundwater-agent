{
  "description": "按共有且排序的时间轴取 floor(月份数 × trainRatio)；fitRows 包含训练期最初的上下文行。 trainTargets 从 inputWindow 起到训练边界前；holdoutTargets 从边界起；同一分组同一时间必须唯一，各井时间轴须一致。 源域显式 trainRatio=1，允许空 holdoutTargets；目标域 0.8，必须有足够的训练窗口和留出样本。",
  "domain": "timeseries",
  "errorCodes": [
    "RULESET_INVALID",
    "RULESET_TOO_LARGE",
    "INPUT_CARDINALITY_INVALID",
    "FIELD_REQUIRED",
    "DUPLICATE_FIELD",
    "NON_NUMERIC_VALUE",
    "OUTPUT_FIELD_CONFLICT",
    "EMPTY_RESULT",
    "TIME_AXIS_MISMATCH",
    "DUPLICATE_TIMESTAMP",
    "DUPLICATE_SERIES",
    "TIMEZONE_UNSUPPORTED",
    "TRAINING_WINDOW_INSUFFICIENT",
    "HOLDOUT_REQUIRED",
    "TARGET_NOT_FOUND",
    "TENSOR_SHAPE_INVALID",
    "ATTENTION_DIMENSIONS_INVALID",
    "MODEL_WEIGHTS_INVALID",
    "TRAINING_NON_FINITE",
    "PREDICTION_NON_FINITE",
    "SAMPLE_INDEX_INVALID",
    "CRS_REQUIRED",
    "CRS_MISMATCH",
    "EMPTY_GEOMETRY",
    "INVALID_GEOMETRY",
    "GEOMETRY_TYPE_INVALID",
    "COORDINATE_INVALID",
    "METRIC_CRS_REQUIRED",
    "EXTENT_INVALID",
    "ROTATED_GRID_UNSUPPORTED",
    "BAND_INVALID",
    "IMAGERY_COVERAGE_INSUFFICIENT"
  ],
  "examples": [
    {
      "clientRequestId": "example-timeseries-chronological_split",
      "inputs": {
        "data": {
          "artifactId": "art_example_01"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "timeseries.chronological_split",
        "version": "1.0.0"
      },
      "parameters": {
        "groupField": "station",
        "inputWindow": 3,
        "timeField": "time",
        "trainRatio": 0.75
      },
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "timeseries.chronological_split",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "parquet"
      ],
      "mediaTypes": [
        "application/vnd.apache.parquet"
      ],
      "name": "data",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "parquet"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "application/vnd.apache.parquet"
      ],
      "name": "fitRows"
    },
    {
      "formats": [
        "parquet"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "application/vnd.apache.parquet"
      ],
      "name": "trainTargets"
    },
    {
      "formats": [
        "parquet"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "application/vnd.apache.parquet"
      ],
      "name": "holdoutTargets"
    },
    {
      "formats": [
        "json"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "application/json"
      ],
      "name": "split"
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {
      "groupField": {
        "minLength": 1,
        "type": "string"
      },
      "inputWindow": {
        "minimum": 1,
        "type": "integer"
      },
      "timeField": {
        "minLength": 1,
        "type": "string"
      },
      "trainRatio": {
        "exclusiveMinimum": 0,
        "maximum": 1,
        "type": "number"
      }
    },
    "required": [
      "groupField",
      "timeField",
      "trainRatio",
      "inputWindow"
    ],
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "timeseries",
    "structured"
  ],
  "timeoutSeconds": 1800,
  "title": "按时间划分训练行与预测目标行",
  "version": "1.0.0"
}
