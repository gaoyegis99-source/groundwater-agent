        "cog",
        "geotiff"
      ],
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "flowDirection",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "geotiff"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "basins"
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {},
    "type": "object"
  },
  "runtime": "native",
  "tags": [
