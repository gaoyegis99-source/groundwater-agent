      "inputs": {
        "predictions": {
          "artifactId": "art_example_01"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "statistics.regression_metrics",
        "version": "1.0.0"
      },
      "parameters": {
        "actualField": "actual",
        "baselineField": "persistence",
        "groupField": "station",
        "predictedField": "predicted",
        "unit": "m"
      },
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "statistics.regression_metrics",
  "inputs": [
    {
      "cardinality": "one",
