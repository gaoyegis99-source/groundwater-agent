{
  "description": "输出逐行 error=predicted-actual、absolute_error，以及总体/分井 MAE、RMSE、R²、样本数和声明基线指标。同一组数据上比较模型和基线；perGroup 逐组保留 baseline_mae、baseline_rmse、baseline_r2、baseline_r2_reason、rmse_improvement_pct、improvement_reason 与 unit。基线 RMSE 为零时改善率为 null 并声明原因，不伪造 0%；样本少于 2 或 actual 为常量时 R² 为 null 并声明原因，不把 NaN/Infinity 写入 JSON。",
  "domain": "statistics",
  "errorCodes": [
    "RULESET_INVALID",
    "RULESET_TOO_LARGE",
    "INPUT_CARDINALITY_INVALID",
    "FIELD_REQUIRED",
    "DUPLICATE_FIELD",
    "NON_NUMERIC_VALUE",
    "OUTPUT_FIELD_CONFLICT",
    "EMPTY_RESULT",
    "TIME_AXIS_MISMATCH",
    "DUPLICATE_TIMESTAMP",
    "DUPLICATE_SERIES",
    "TIMEZONE_UNSUPPORTED",
    "TRAINING_WINDOW_INSUFFICIENT",
    "HOLDOUT_REQUIRED",
    "TARGET_NOT_FOUND",
    "TENSOR_SHAPE_INVALID",
    "ATTENTION_DIMENSIONS_INVALID",
    "MODEL_WEIGHTS_INVALID",
    "TRAINING_NON_FINITE",
    "PREDICTION_NON_FINITE",
    "SAMPLE_INDEX_INVALID",
    "CRS_REQUIRED",
    "CRS_MISMATCH",
    "EMPTY_GEOMETRY",
    "INVALID_GEOMETRY",
    "GEOMETRY_TYPE_INVALID",
    "COORDINATE_INVALID",
    "METRIC_CRS_REQUIRED",
    "EXTENT_INVALID",
    "ROTATED_GRID_UNSUPPORTED",
    "BAND_INVALID",
    "IMAGERY_COVERAGE_INSUFFICIENT"
  ],
  "examples": [
    {
