          "nearest",
          "bilinear",
          "cubic"
        ],
        "type": "string"
      },
      "targetCrs": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*:[A-Za-z0-9._-]+$",
        "type": "string"
      }
    },
    "required": [
      "targetCrs"
    ],
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "raster",
    "reproject"
  ],
  "timeoutSeconds": 3600,
  "title": "Reproject raster",
  "version": "1.0.0"
}
