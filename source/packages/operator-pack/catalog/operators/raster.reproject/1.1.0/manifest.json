{
  "description": "Reproject one raster band into the CRS and exact affine grid of a reference raster in a single warp. Explicitly choose nearest, bilinear or cubic. Invalid and uncovered cells use NaN NoData.",
  "domain": "raster",
  "errorCodes": [
    "CRS_REQUIRED",
    "GRID_REQUIRED",
    "CRS_MISMATCH",
    "BAND_INVALID",
    "NODATA_MASK_UNSUPPORTED",
    "RESAMPLING_UNSUPPORTED",
    "RASTER_WARP_FAILED"
  ],
  "examples": [
    {
      "clientRequestId": "example-raster-reproject",
      "inputs": {
        "raster": {
          "artifactId": "art_example_01"
        },
        "reference": {
          "artifactId": "art_example_02"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "raster.reproject",
        "version": "1.1.0"
      },
      "parameters": {
        "band": 1,
        "resampling": "nearest"
      },
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "raster.reproject",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "cog",
        "geotiff"
      ],
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "raster",
      "required": true
    },
    {
      "cardinality": "one",
      "formats": [
        "cog",
        "geotiff"
      ],
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "reference",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "geotiff"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "raster"
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {
      "band": {
        "default": 1,
        "minimum": 1,
        "type": "integer"
      },
      "resampling": {
        "enum": [
          "nearest",
          "bilinear",
          "cubic"
        ],
        "type": "string"
      }
    },
    "required": [
      "resampling"
    ],
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "raster",
    "reproject",
    "reprojection",
    "栅格重投影",
    "重投影",
    "reference grid",
    "capability:reproject",
    "重投影影像",
    "以参考栅格为目标重投影"
  ],
  "timeoutSeconds": 3600,
  "title": "Reproject raster to reference grid",
  "version": "1.1.0",
  "composition": {
    "portSemantics": {
      "raster": {
        "requiredFacts": [
          "crs",
          "grid",
          "rasterBands"
        ]
      },
      "reference": {
        "requiredFacts": [
          "crs",
          "grid"
        ]
      }
    },
    "outputSemantics": {
      "raster": {
        "inherit": [
          {
            "inputPort": "reference",
            "facts": [
              "crs",
              "grid"
            ]
          },
          {
            "inputPort": "raster",
            "facts": [
              "valueKind"
            ]
          }
        ],
        "fixed": {
          "rasterBands": [
            {
              "dtype": "float64",
              "nodata": "nan",
              "maskFlags": [
                "nodata"
              ]
            }
          ]
        }
      }
    },
    "constraints": [
      {
        "id": "selected-band",
        "condition": {
          "predicate": "rasterBandExists",
          "arguments": [
            {
              "port": "raster",
              "property": "rasterBands"
            },
            {
              "parameter": "band"
            }
          ]
        },
        "severity": "error",
        "checkStage": "compile"
      },
      {
        "id": "input-nodata",
        "condition": {
          "predicate": "rasterMaskSupported",
          "arguments": [
            {
              "port": "raster",
              "property": "rasterBands"
            },
            {
              "parameter": "band"
            }
          ]
        },
        "severity": "error",
        "checkStage": "compile"
      }
    ]
  }
}
