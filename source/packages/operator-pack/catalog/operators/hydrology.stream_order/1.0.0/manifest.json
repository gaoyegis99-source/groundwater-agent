{
  "description": "Calculates Strahler order for a binary stream mask and fixed-code D8 directions.",
  "domain": "hydrology",
  "errorCodes": [
    "CRS_REQUIRED",
    "CRS_MISMATCH",
    "PROJECTED_CRS_REQUIRED",
    "GRID_MISMATCH",
    "FLOW_DIRECTION_INVALID",
    "FLOW_CYCLE",
    "STREAM_MASK_INVALID",
    "RASTER_INVALID"
  ],
  "examples": [
    {
      "clientRequestId": "example-hydrology-stream_order",
      "inputs": {
        "flowDirection": {
          "artifactId": "art_example_01"
        },
        "streams": {
          "artifactId": "art_example_02"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "hydrology.stream_order",
        "version": "1.0.0"
      },
      "parameters": {},
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "hydrology.stream_order",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "cog",
        "geotiff"
      ],
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "flowDirection",
      "required": true
    },
    {
      "cardinality": "one",
      "formats": [
        "cog",
        "geotiff"
      ],
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "streams",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "geotiff"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "streamOrder"
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {},
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "hydrology",
    "stream",
    "strahler",
    "capability:stream_order",
    "河流分级",
    "河网分级",
    "河流等级",
    "计算河网的 Strahler 级别"
  ],
  "timeoutSeconds": 3600,
  "title": "Strahler stream order",
  "version": "1.0.0",
  "composition": {
    "portSemantics": {
      "flowDirection": {
        "requires": {
          "valueKind": "d8-direction"
        }
      },
      "streams": {
        "requires": {
          "valueKind": "stream-mask"
        }
      }
    },
    "outputSemantics": {
      "streamOrder": {
        "fixed": {
          "valueKind": "strahler-order"
        },
        "inherit": [
          {
            "inputPort": "flowDirection",
            "facts": [
              "crs",
              "grid"
            ]
          }
        ]
      }
    }
  }
}
