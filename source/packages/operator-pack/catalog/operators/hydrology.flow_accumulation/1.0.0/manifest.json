      "operator": {
        "id": "hydrology.flow_accumulation",
        "version": "1.0.0"
      },
      "parameters": {},
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "hydrology.flow_accumulation",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "cog",
        "geotiff"
      ],
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "flowDirection",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "geotiff"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "accumulation"
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {},
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "hydrology",
