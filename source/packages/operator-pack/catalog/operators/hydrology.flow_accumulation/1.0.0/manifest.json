    "PROJECTED_CRS_REQUIRED",
    "FLOW_DIRECTION_INVALID",
    "FLOW_CYCLE",
    "RASTER_INVALID"
  ],
  "examples": [
    {
      "clientRequestId": "example-hydrology-flow_accumulation",
      "inputs": {
