{
  "description": "Dissolve vector features operator.",
  "domain": "vector",
  "errorCodes": [
    "CRS_REQUIRED",
    "LAYER_REQUIRED",
    "FIELD_REQUIRED",
    "UNSUPPORTED_DIMENSION",
    "INVALID_GEOMETRY",
    "POINT_GEOMETRY_REQUIRED",
    "INSUFFICIENT_UNIQUE_POINTS",
    "COLLINEAR_POINTS",
    "CRS_UNSUPPORTED",
    "BLOCKED_BY_ENVIRONMENT"
  ],
  "examples": [
    {
      "clientRequestId": "example-vector-dissolve",
      "inputs": {
        "vector": {
          "artifactId": "art_example_01"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "vector.dissolve",
        "version": "1.0.0"
      },
      "parameters": {},
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "vector.dissolve",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "flatgeobuf",
        "geojson",
        "geopackage",
        "geoparquet",
        "parquet"
      ],
      "mediaTypes": [
        "application/geopackage+sqlite3",
        "application/geo+json",
        "application/flatgeobuf",
        "application/vnd.apache.parquet"
      ],
      "name": "vector",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "geopackage"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "application/geopackage+sqlite3"
      ],
      "name": "vector"
    },
    {
      "kind": "value",
      "name": "summary",
      "schema": {
        "properties": {
          "inputFeatureCount": {
            "minimum": 0,
            "type": "integer"
          },
          "inputPointCount": {
            "minimum": 0,
            "type": "integer"
          },
          "uniquePointCount": {
            "minimum": 0,
            "type": "integer"
          },
          "duplicatePointCount": {
            "minimum": 0,
            "type": "integer"
          },
          "hullGeometryType": {
            "const": "Polygon",
            "type": "string"
          },
          "crs": {
            "minLength": 1,
            "type": "string"
          },
          "crsKind": {
            "enum": [
              "GEOGRAPHIC",
              "PROJECTED"
            ],
            "type": "string"
          },
          "measurementMethod": {
            "enum": [
              "GEODESIC_ELLIPSOID",
              "PLANAR_PROJECTED_TO_METRES"
            ],
            "type": "string"
          },
          "areaSquareMeters": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "perimeterMeters": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "areaUnit": {
            "const": "m2",
            "type": "string"
          },
          "perimeterUnit": {
            "const": "m",
            "type": "string"
          },
          "resultKind": {
            "enum": [
              "DISSOLVED_VECTOR",
              "GEOMETRIC_CONVEX_HULL"
            ],
            "type": "string"
          },
          "interpretation": {
            "minLength": 1,
            "type": "string"
          },
          "limitations": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "resultKind",
          "interpretation",
          "limitations"
        ],
        "type": "object"
      }
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {
      "field": {
        "minLength": 1,
        "type": "string"
      },
      "layer": {
        "minLength": 1,
        "type": "string"
      },
      "pointCoverageMode": {
        "default": false,
        "type": "boolean"
      },
      "separateDisjoint": {
        "default": false,
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "runtime": "qgis",
  "tags": [
    "vector",
    "dissolve"
  ],
  "timeoutSeconds": 3600,
  "title": "Dissolve vector features",
  "version": "1.0.0"
}
