{
  "description": "Calculate one statistic across two to sixteen exactly aligned raster bands.",
  "domain": "raster",
  "errorCodes": [
    "BAND_INVALID",
    "CRS_REQUIRED",
    "GRID_MISMATCH",
    "INPUT_CARDINALITY_INVALID",
    "OUTPUT_VALIDATION_FAILED"
  ],
  "examples": [
    {
      "clientRequestId": "example-raster-cell_statistics",
      "inputs": {
        "rasters": [
          {
            "artifactId": "art_example_01"
          },
          {
            "artifactId": "art_example_02"
          }
        ]
      },
      "mode": "ASYNC",
      "operator": {
        "id": "raster.cell_statistics",
        "version": "1.0.0"
      },
      "parameters": {
        "band": 1,
        "minimumValidInputs": 2,
        "statistic": "mean"
      },
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "raster.cell_statistics",
  "inputs": [
    {
      "cardinality": "many",
      "formats": [
        "geotiff",
        "cog"
      ],
      "maxItems": 16,
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "rasters",
      "required": true,
      "minItems": 2
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "geotiff"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "image/tiff"
      ],
      "name": "raster"
    },
    {
      "kind": "value",
      "name": "summary",
      "schema": {
        "type": "object",
        "properties": {
          "inputCount": {
            "type": "integer",
            "minimum": 0
          },
          "noDataCellCount": {
            "type": "integer",
            "minimum": 0
          },
          "validCellCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "inputCount",
          "noDataCellCount",
          "validCellCount"
        ],
        "additionalProperties": false
      },
      "maxBytes": 1048576
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {
      "band": {
        "default": 1,
        "minimum": 1,
        "type": "integer"
      },
      "minimumValidInputs": {
        "default": 1,
        "maximum": 16,
        "minimum": 1,
        "type": "integer"
      },
      "statistic": {
        "enum": [
          "min",
          "max",
          "mean",
          "median",
          "sum",
          "populationStddev"
        ],
        "type": "string"
      }
    },
    "required": [
      "statistic"
    ],
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "raster",
    "cell_statistics",
    "capability:cell_statistics",
    "逐像元统计",
    "像元统计",
    "多栅格统计",
    "逐像元统计多幅栅格"
  ],
  "timeoutSeconds": 3600,
  "title": "Calculate cell statistics",
  "version": "1.0.0",
  "composition": {
    "portSemantics": {
      "rasters": {
        "requiredFacts": [
          "crs",
          "grid",
          "rasterBands"
        ]
      }
    },
    "outputSemantics": {
      "raster": {
        "inherit": [
          {
            "inputPort": "rasters",
            "facts": [
              "crs",
              "grid"
            ]
          }
        ],
        "fixed": {
          "rasterBands": [
            {
              "dtype": "float32",
              "nodata": "nan",
              "maskFlags": [
                "nodata"
              ]
            }
          ]
        }
      }
    },
    "constraints": [
      {
        "id": "same-crs",
        "condition": {
          "predicate": "sameCrs",
          "arguments": [
            {
              "port": "rasters",
              "property": "crs"
            },
            {
              "port": "rasters",
              "property": "crs"
            }
          ]
        },
        "severity": "error",
        "checkStage": "compile"
      },
      {
        "id": "same-grid",
        "condition": {
          "predicate": "sameGrid",
          "arguments": [
            {
              "port": "rasters",
              "property": "grid"
            },
            {
              "port": "rasters",
              "property": "grid"
            },
            {
              "value": 0
            }
          ]
        },
        "severity": "error",
        "checkStage": "compile"
      },
      {
        "id": "selected-band",
        "condition": {
          "predicate": "rasterBandExists",
          "arguments": [
            {
              "port": "rasters",
              "property": "rasterBands"
            },
            {
              "parameter": "band"
            }
          ]
        },
        "severity": "error",
        "checkStage": "compile"
      },
      {
        "id": "input-nodata",
        "condition": {
          "predicate": "rasterMaskSupported",
          "arguments": [
            {
              "port": "rasters",
              "property": "rasterBands"
            },
            {
              "parameter": "band"
            }
          ]
        },
        "severity": "error",
        "checkStage": "compile"
      }
    ]
  }
}
