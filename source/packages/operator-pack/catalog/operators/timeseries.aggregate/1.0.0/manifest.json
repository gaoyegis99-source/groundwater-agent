      "operator": {
        "id": "timeseries.aggregate",
        "version": "1.0.0"
      },
      "parameters": {
        "frequency": "month",
        "groupField": "station",
        "timeField": "time",
        "valueField": "value"
      },
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "timeseries.aggregate",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "csv",
        "parquet",
        "arrow-ipc-file"
      ],
