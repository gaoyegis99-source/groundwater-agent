      },
      "valueField": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "groupField",
      "timeField",
      "valueField",
      "frequency"
    ],
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "timeseries",
