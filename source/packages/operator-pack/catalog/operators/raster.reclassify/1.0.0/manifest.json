              "property": "rasterBands"
            },
            {
              "parameter": "band"
            }
          ]
        },
        "severity": "error",
        "checkStage": "compile"
      },
      {
        "id": "input-nodata",
        "condition": {
          "predicate": "rasterMaskSupported",
          "arguments": [
            {
              "port": "raster",
              "property": "rasterBands"
            },
            {
              "parameter": "band"
            }
          ]
        },
        "severity": "error",
        "checkStage": "compile"
      },
      {
        "id": "output-nodata",
        "condition": {
          "predicate": "rasterNoDataFits",
          "arguments": [
            {
              "parameter": "noData"
            },
            {
              "parameter": "outputType"
            }
          ]
