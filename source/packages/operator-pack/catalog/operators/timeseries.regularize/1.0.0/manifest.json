{
  "description": "Create an explicit calendar timeline and mark bounded linear or previous-value imputations without extrapolation.",
  "domain": "timeseries",
  "errorCodes": [
    "DUPLICATE_PERIOD",
    "DUPLICATE_TIMESTAMP",
    "FIELD_REQUIRED",
    "FREQUENCY_UNSUPPORTED",
    "INTERPOLATION_INVALID",
    "NON_NUMERIC_VALUE",
    "OUTPUT_ROW_LIMIT_EXCEEDED",
    "OUTPUT_VALIDATION_FAILED",
    "TIMESTAMP_INVALID",
    "TIMEZONE_UNSUPPORTED",
    "TIME_RANGE_INVALID"
  ],
  "examples": [
    {
      "clientRequestId": "example-timeseries-regularize",
      "inputs": {
        "observations": {
          "artifactId": "art_example_01"
        }
      },
      "mode": "ASYNC",
      "operator": {
        "id": "timeseries.regularize",
        "version": "1.0.0"
      },
      "parameters": {
        "expectedEnd": "2020-03-31",
        "expectedStart": "2020-01-01",
        "frequency": "month",
        "groupField": "station",
        "interpolationMethod": "linear",
        "maxGapPeriods": 1,
        "maxOutputRows": 100,
        "timeField": "time",
        "valueField": "value"
      },
      "schemaVersion": "operator-execution-request.v1"
    }
  ],
  "id": "timeseries.regularize",
  "inputs": [
    {
      "cardinality": "one",
      "formats": [
        "csv",
        "parquet",
        "arrow-ipc-file"
      ],
      "mediaTypes": [
        "text/csv",
        "application/vnd.apache.parquet",
        "application/vnd.apache.arrow.file"
      ],
      "name": "observations",
      "required": true
    }
  ],
  "memoryLimitBytes": 8589934592,
  "outputs": [
    {
      "formats": [
        "parquet"
      ],
      "kind": "artifact",
      "mediaTypes": [
        "application/vnd.apache.parquet"
      ],
      "name": "series"
    },
    {
      "kind": "value",
      "name": "summary",
      "schema": {
        "type": "object"
      }
    }
  ],
  "parametersSchema": {
    "additionalProperties": false,
    "properties": {
      "expectedEnd": {
        "minLength": 1,
        "type": "string"
      },
      "expectedStart": {
        "minLength": 1,
        "type": "string"
      },
      "frequency": {
        "enum": [
          "day",
          "month",
          "quarter",
          "year"
        ],
        "type": "string"
      },
      "groupField": {
        "minLength": 1,
        "type": "string"
      },
      "interpolationMethod": {
        "enum": [
          "linear",
          "previous"
        ],
        "type": "string"
      },
      "maxGapPeriods": {
        "minimum": 1,
        "type": "integer"
      },
      "maxOutputRows": {
        "maximum": 5000000,
        "minimum": 1,
        "type": "integer"
      },
      "timeField": {
        "minLength": 1,
        "type": "string"
      },
      "valueField": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "groupField",
      "timeField",
      "valueField",
      "frequency",
      "expectedStart",
      "expectedEnd",
      "interpolationMethod",
      "maxGapPeriods",
      "maxOutputRows"
    ],
    "type": "object"
  },
  "runtime": "native",
  "tags": [
    "timeseries",
    "regularize"
  ],
  "timeoutSeconds": 1800,
  "title": "Regularize and interpolate time series",
  "version": "1.0.0"
}
