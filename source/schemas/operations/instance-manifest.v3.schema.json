{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwater.local/schemas/operations/instance-manifest.v3.schema.json",
  "title": "Groundwater Domain Analysis System instance manifest v3 (V6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instanceId",
    "releaseId",
    "profile",
    "composeProject",
    "dataRoot",
    "stateRoot",
    "ports",
    "backupRoot",
    "createdAt",
    "status"
  ],
  "properties": {
    "schemaVersion": {"const": "instance-manifest.v3"},
    "instanceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
    "releaseId": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
    "profile": {"enum": ["development", "pilot"]},
    "composeProject": {"type": "string", "pattern": "^groundwater-v6-[a-z0-9][a-z0-9-]{0,62}$"},
    "dataRoot": {"type": "string", "pattern": "^/"},
    "stateRoot": {"type": "string", "pattern": "^/"},
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "operator"],
      "properties": {
        "gateway": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "operator": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "backupRoot": {
      "oneOf": [
        {"type": "string", "pattern": "^/"},
        {"type": "null"}
      ]
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["created", "active", "stopped", "restored", "destroyed"]}
  }
}
