      "id": "groundwater.monitoring-trend.seasonal-and-threshold",
      "version": "1.0.0",
      "label": "监测趋势、季节变化与阈值事件",
      "workflowRef": {
        "id": "groundwater.monitoring-trend",
        "version": "1.1.0",
        "checksum": "sha256:156c558d24d5495124cb1735d9b1c2ba0baffafa42a2dc296425891150a5b07e"
      },
      "modelRef": {
        "id": "groundwater.monitoring-trend",
