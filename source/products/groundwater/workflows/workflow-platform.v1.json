      },
      "resultContractRef": {
        "id": "groundwater.monitoring-trend.results",
        "version": "1.0.0",
        "checksum": "sha256:bf0cd63ec9bad85390725387c403d6d0adcd400212a0186dc4dfeabc40e7e4bb"
      },
      "inputRoles": {
        "observations": {
          "meaning": "一个可查询的、包含分组、时间和数值字段的精确监测数据版本。",
          "preconditions": [
            "Data 版本声明所选观测值的单位、时间字段及覆盖区间。",
            "所选字段的类型满足 Model 要求。分析窗、基准期和对比期在声明覆盖区间内，且基准期与对比期不得重叠。",
            "仅在使用者给出阈值及比较方向后分析事件，阈值沿用所选观测值字段的单位。",
            "季节节点与事件节点直接读取输入观测。按对象划分后，每个日历频率周期最多一行，每个年份的每个季节也最多一行。",
            "每条输入记录的时间和数值须可解析，阈值事件要求每条记录具有有限数值。缺测周期可由缺测诊断区分。",
            "时间端点须使用 ISO 格式。比较端点统一使用无偏移时间，或全部显式附带 UTC 偏移。"
          ]
        }
      },
      "parameters": {
        "fixed": {
          "seasonalTrendEnabled": true,
          "thresholdEventsEnabled": true
        },
        "adjustable": [
          "groupField",
          "timeField",
          "valueField",
          "frequency",
          "expectedStart",
          "expectedEnd",
          "baselineStart",
          "baselineEnd",
          "comparisonStart",
          "comparisonEnd",
          "aggregation",
          "alpha",
          "threshold",
          "seasonFrequency",
          "eventComparison",
          "eventThreshold"
        ],
        "defaultSource": "PINNED_EXECUTABLE_MODEL"
      },
      "applicability": "用于按监测对象分析长时序趋势，同时需要季节趋势和指定阈值事件时。季节趋势须有至少两个可比较的季节周期。",
      "limitations": [
        "输入缺测会降低趋势检验能力，需结合覆盖率和连续缺测段判断。",
        "Pettitt 的候选变化点和非参数趋势均不能确定成因。",
        "用户阈值只适用于本次分析，不能自动解释为监管或合规标准。",
        "结果合同所列质量来源用于解读可评价性，阶段证据为合成数据技术回归。"
      ],
      "validationEvidence": {
        "kind": "SYNTHETIC_WORKFLOW_GOLDEN",
