      },
      "inputRoles": {
        "observations": {
          "meaning": "一个包含井号、井点坐标、观测时间、参考面高程和埋深的精确 Data 版本。",
          "preconditions": [
            "提供六个数据字段的列名。观测时间字段可采用 Data 版本已声明的字段。",
            "所选参考面高程与从该面向下量取的埋深均以米记录，Data 版本须声明字段含义、参考面和统一垂向基准。",
            "Data 版本须声明坐标系、观测时间字段和覆盖区间。显式给出源 EPSG 坐标系及目标米制投影 EPSG 坐标系。",
            "观测时间字段须为时间戳类型且 Data 版本须声明 UTC 时区。原始字符串时间须规范为 UTC 时间戳后发布为 Parquet 或 Arrow 数据版本。",
            "同井、同一时刻最多一条观测。目标时刻使用 UTC，须以 Z 或 +00:00 结尾。缺少匹配观测的井见时点选择诊断。",
            "输入表须留出 hydraulic_head_m 列名用于计算水头。应结合井点空间覆盖、格网大小和诊断判断结果。",
            "使用者须提供目标时刻、格网大小（米）、渗透系数（米/天）和有效孔隙率（0 到 1 之间的小数，含 1）。"
          ]
        }
      },
      "parameters": {
        "fixed": {
          "selection": "exact",
          "maxAgeDays": 0,
          "referenceElevationUnit": "m",
          "depthToWaterUnit": "m",
          "valueField": "hydraulic_head_m",
          "power": 2.0,
          "neighborCount": 5
        },
        "adjustable": [
          "wellField",
          "timeField",
          "xField",
          "yField",
          "referenceElevationField",
          "depthToWaterField",
          "targetTime",
          "sourceCrs",
          "targetCrs",
          "pixelSize",
          "hydraulicConductivityMetersPerDay",
          "effectivePorosity"
        ],
        "defaultSource": "PINNED_EXECUTABLE_MODEL"
      },
      "applicability": "用于以同一目标时刻的井点观测估算稳态二维水平流向、达西通量和孔隙水流速。",
      "limitations": [
        "假设介质均质且各向同性，采用标量渗透系数和空间统一的有效孔隙率。",
        "模型估算限于稳态二维水平流动，适用于可忽略垂向流动、瞬态储水和密度差异的场景。",
        "水力梯度和流向继承水头插值误差。解读时应检查井点分布、格网分辨率、边缘效应和时点选择诊断。",
        "输出属于推导估算。合成案例验证了技术链路，场地适用性和业务验收需独立验证。"
      ],
      "validationEvidence": {
