{
  "cases": {
    "flow-field": {
      "inputs": {
        "observations": "groundwater.flow-field"
      },
      "keyOutputs": [
        "summary"
      ],
      "parameters": {
        "depthToWaterField": "depth_to_water_m",
        "depthToWaterUnit": "m",
        "effectivePorosity": 0.25,
        "hydraulicConductivityMetersPerDay": 10.0,
        "maxAgeDays": 0,
        "neighborCount": 5,
        "pixelSize": 250.0,
        "power": 2.0,
        "referenceElevationField": "reference_elevation_m",
        "referenceElevationUnit": "m",
        "selection": "exact",
        "sourceCrs": "EPSG:3857",
        "targetCrs": "EPSG:3857",
        "targetTime": "2024-01-03T00:00:00Z",
        "timeField": "time",
        "valueField": "hydraulic_head_m",
        "wellField": "station",
        "xField": "x",
        "yField": "y"
      },
      "workflow": "domains/groundwater/6.0.0/workflows/flow-field.workflow.json"
    },
    "monitoring-trend": {
      "inputs": {
        "observations": "monitoring.timeseries"
      },
      "keyOutputs": [
        "aggregate-summary",
        "change-point-summary",
        "completeness-summary",
        "gap-run-summary",
        "linear-summary",
        "mann-kendall-summary",
        "outlier-summary",
        "period-change-summary",
        "seasonal-trend-summary",
        "threshold-event-summary"
      ],
      "parameters": {
        "aggregation": "mean",
        "alpha": 0.05,
        "baselineEnd": "2022-12-31",
        "baselineStart": "2020-01-01",
        "comparisonEnd": "2025-12-31",
        "comparisonStart": "2023-01-01",
        "eventComparison": "above",
        "eventThreshold": 10.0,
        "expectedEnd": "2025-12-31",
        "expectedStart": "2020-01-01",
        "frequency": "month",
        "groupField": "station",
        "seasonFrequency": "month",
        "seasonalTrendEnabled": true,
        "threshold": 3.5,
        "thresholdEventsEnabled": true,
        "timeField": "time",
        "valueField": "value"
      },
      "workflow": "domains/groundwater/6.0.0/workflows/monitoring-trend.workflow.json"
    },
    "render-map": {
      "inputs": {
        "data": "cartography.points"
      },
      "keyOutputs": [
        "map-summary"
      ],
      "parameters": {
        "height": 768,
        "palette": "viridis",
        "title": "Monitoring values",
        "unit": "m",
        "valueField": "value",
        "width": 1024
      },
      "workflow": "domains/groundwater/6.0.0/workflows/render-map.workflow.json"
    }
  },
  "schemaVersion": "workflow-golden-cases.v1"
}
