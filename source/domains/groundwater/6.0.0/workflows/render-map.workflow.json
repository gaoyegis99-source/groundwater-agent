{
  "schemaVersion": "workflow.v6",
  "workflowId": "groundwater.render-map",
  "version": "1.1.0",
  "inputs": [
    {
      "name": "data",
      "cardinality": "one",
      "mediaTypes": [
        "application/geo+json",
        "image/tiff"
      ],
      "formats": [
        "geojson",
        "geotiff",
        "cog"
      ]
    }
  ],
  "parameters": [
    "title",
    "valueField",
    "palette",
    "width",
    "height",
    "unit"
  ],
  "nodes": [
    {
      "nodeId": "render",
      "operatorId": "cartography.render-png",
      "operatorVersion": "1.0.0",
      "inputs": {
        "data": {
          "workflowInput": "data"
        }
      },
      "parameters": {
        "title": {
          "workflowParameter": "title"
        },
        "valueField": {
          "workflowParameter": "valueField"
        },
        "palette": {
          "workflowParameter": "palette"
        },
        "width": {
          "workflowParameter": "width"
        },
        "height": {
          "workflowParameter": "height"
        },
        "unit": {
          "workflowParameter": "unit"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "map-image",
      "nodeOutput": {
        "nodeId": "render",
        "port": "image"
      }
    },
    {
      "name": "map-summary",
      "nodeOutput": {
        "nodeId": "render",
        "port": "summary"
      }
    }
  ]
}
