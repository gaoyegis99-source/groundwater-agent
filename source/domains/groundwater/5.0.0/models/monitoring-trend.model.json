          "type": "string",
          "minLength": 1
        },
        "baselineEnd": {
          "type": "string",
          "minLength": 1
        },
        "comparisonStart": {
          "type": "string",
          "minLength": 1
        },
        "comparisonEnd": {
          "type": "string",
          "minLength": 1
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "mean",
            "median",
            "min",
            "max"
          ]
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "versionId",
        "groupField",
        "timeField",
        "valueField",
        "frequency",
        "expectedStart",
        "expectedEnd",
        "baselineStart",
        "baselineEnd",
        "comparisonStart",
        "comparisonEnd",
        "aggregation"
      ],
      "additionalProperties": false
    }
  },
  "inputBindings": {
    "observations": "versionId"
  },
  "defaultParameters": {
    "alpha": 0.05,
    "threshold": 3.5
