  },
  "tool": {
    "name": "run_flow_field",
    "description": "Calculate hydraulic head from elevation minus depth, then interpolate that computed field and derive Darcy velocity from one exact Data version.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "wellField": {
          "type": "string",
          "minLength": 1
        },
        "timeField": {
          "type": "string",
          "minLength": 1
        },
        "valueField": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the new computed hydraulic-head column. It must not already exist in the input table."
        },
        "xField": {
          "type": "string",
          "minLength": 1
        },
        "yField": {
          "type": "string",
          "minLength": 1
        },
        "referenceElevationField": {
          "type": "string",
          "minLength": 1
        },
        "depthToWaterField": {
          "type": "string",
          "minLength": 1
        },
        "referenceElevationUnit": {
          "type": "string",
          "enum": [
            "m",
            "cm",
            "mm"
          ]
        },
        "depthToWaterUnit": {
          "type": "string",
          "enum": [
            "m",
            "cm",
            "mm"
          ]
        },
        "targetTime": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "string",
          "enum": [
            "exact",
            "latestAtOrBefore",
            "nearest"
          ]
        },
        "maxAgeDays": {
          "type": "number",
          "minimum": 0
        },
        "sourceCrs": {
          "type": "string",
          "minLength": 1
        },
        "targetCrs": {
          "type": "string",
          "minLength": 1
        },
        "pixelSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "power": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "neighborCount": {
          "type": "integer",
          "minimum": 1
        },
        "hydraulicConductivityMetersPerDay": {
          "type": "number",
          "minimum": 0
        },
        "effectivePorosity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "versionId",
        "wellField",
        "timeField",
        "xField",
        "yField",
        "referenceElevationField",
        "depthToWaterField",
        "targetTime",
        "sourceCrs",
        "targetCrs",
        "pixelSize",
        "hydraulicConductivityMetersPerDay",
        "effectivePorosity"
      ],
      "additionalProperties": false
    }
  },
  "inputBindings": {
    "observations": "versionId"
  },
  "defaultParameters": {
    "valueField": "hydraulic_head_m",
    "referenceElevationUnit": "m",
    "depthToWaterUnit": "m",
    "selection": "latestAtOrBefore",
    "maxAgeDays": 30,
    "power": 2,
    "neighborCount": 12
  },
  "parameterBindings": {
    "wellField": "wellField",
    "timeField": "timeField",
