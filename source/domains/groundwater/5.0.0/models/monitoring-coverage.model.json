  },
  "tool": {
    "name": "run_monitoring_coverage",
    "description": "Dissolve all monitoring well points, compute one QGIS convex hull, then convert to GeoJSON. Geometrical monitoring-well coverage only; this is not aquifer extent or influence area. Requires at least three non-collinear points.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "outputFormat": {
          "type": "string",
          "enum": [
            "geojson"
          ]
        }
      },
      "required": [
        "versionId"
      ],
      "additionalProperties": false
    }
  },
  "inputBindings": {
    "wells": "versionId"
  },
  "defaultParameters": {
    "outputFormat": "geojson"
  },
  "parameterBindings": {
    "outputFormat": "outputFormat"
  },
  "deadlineSeconds": 300,
  "maxParallelNodes": 1,
  "finalOutputs": [
    "coverage"
  ],
  "executionService": "executor",
  "executorId": "workflow-dag",
  "outputPublications": {
    "coverage": {
      "title": "Coverage",
      "mediaType": "application/geo+json",
      "format": "geojson",
      "policy": "FILE_ONLY",
      "semantics": {
        "description": "groundwater.monitoring-coverage output coverage.",
        "fields": {},
        "grain": null,
        "time_range": null,
        "timezone": null,
        "crs": null,
        "vertical_datum": null,
        "limitations": [],
        "source": "workflow-declared"
      }
    }
  }
}
