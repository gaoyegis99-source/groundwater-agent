{
  "schemaVersion": "workflow.v6",
  "workflowId": "groundwater.rule-classification",
  "version": "1.0.0",
  "inputs": [
    {
      "name": "data",
      "cardinality": "one",
      "mediaTypes": [
        "text/csv",
        "application/vnd.apache.parquet",
        "application/vnd.apache.arrow.file"
      ],
      "formats": ["csv", "parquet", "arrow-ipc-file"]
    },
    {
      "name": "rules",
      "cardinality": "one",
      "mediaTypes": ["application/json"],
      "formats": ["json"]
    },
    {
      "name": "bindings",
      "cardinality": "one",
      "mediaTypes": ["application/json"],
      "formats": ["json"]
    }
  ],
  "parameters": [],
  "nodes": [
    {
      "nodeId": "classify",
      "operatorId": "table.classify",
      "operatorVersion": "1.0.0",
      "inputs": {
        "data": {"workflowInput": "data"},
        "rules": {"workflowInput": "rules"},
        "bindings": {"workflowInput": "bindings"}
      },
      "parameters": {}
    }
  ],
  "outputs": [
    {
      "name": "classified-table",
      "nodeOutput": {"nodeId": "classify", "port": "classified"}
    },
    {
      "name": "indicator-classifications",
      "nodeOutput": {
        "nodeId": "classify",
        "port": "indicatorClassifications"
      }
    },
    {
      "name": "classification-rule-summary",
      "nodeOutput": {"nodeId": "classify", "port": "ruleSummary"}
    },
    {
      "name": "classification-summary",
      "nodeOutput": {"nodeId": "classify", "port": "summary"}
    }
  ]
}
