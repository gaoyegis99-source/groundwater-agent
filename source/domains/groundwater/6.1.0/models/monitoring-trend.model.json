{
  "schemaVersion": "executable-model.v6",
  "modelId": "groundwater.monitoring-trend",
  "version": "3.1.0",
  "workflowRef": {
    "workflowId": "groundwater.monitoring-trend",
    "version": "1.1.0",
    "checksum": "sha256:156c558d24d5495124cb1735d9b1c2ba0baffafa42a2dc296425891150a5b07e"
  },
  "tool": {
    "name": "run_monitoring_trend",
    "description": "Analyze grouped groundwater monitoring trends from one exact Data version.",
    "inputSchema": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "seasonalTrendEnabled": {"const": true}
            },
            "required": ["seasonalTrendEnabled"]
          },
          "then": {
            "required": ["seasonFrequency"]
          }
        },
        {
          "if": {
            "properties": {
              "thresholdEventsEnabled": {"const": true}
            },
            "required": ["thresholdEventsEnabled"]
          },
          "then": {
            "required": ["eventComparison", "eventThreshold"]
          }
        }
      ],
      "properties": {
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "groupField": {
          "type": "string",
          "minLength": 1
        },
        "timeField": {
          "type": "string",
          "minLength": 1
        },
        "valueField": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "string",
          "enum": [
            "day",
            "month",
            "quarter",
            "year"
          ]
        },
        "expectedStart": {
          "type": "string",
          "minLength": 1
        },
        "expectedEnd": {
          "type": "string",
          "minLength": 1
        },
        "baselineStart": {
          "type": "string",
          "minLength": 1
        },
        "baselineEnd": {
          "type": "string",
          "minLength": 1
        },
        "comparisonStart": {
          "type": "string",
          "minLength": 1
        },
        "comparisonEnd": {
          "type": "string",
          "minLength": 1
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "mean",
            "median",
            "min",
            "max"
          ]
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seasonalTrendEnabled": {
          "type": "boolean"
        },
        "seasonFrequency": {
          "type": "string",
          "enum": ["month", "quarter"]
        },
        "thresholdEventsEnabled": {
          "type": "boolean"
        },
        "eventComparison": {
          "type": "string",
          "enum": ["above", "atOrAbove", "below", "atOrBelow"]
        },
        "eventThreshold": {
          "type": "number"
        }
      },
      "required": [
        "versionId",
        "groupField",
        "timeField",
        "valueField",
        "frequency",
        "expectedStart",
        "expectedEnd",
        "baselineStart",
        "baselineEnd",
        "comparisonStart",
        "comparisonEnd",
        "aggregation"
      ],
      "additionalProperties": false
    }
  },
  "inputBindings": {
    "observations": "versionId"
  },
  "fieldRequirements": [
    {
      "parameter": "groupField",
      "inputParameter": "versionId",
      "identifier": "name",
      "allowedTypes": ["string", "number"]
    },
    {
      "parameter": "timeField",
      "inputParameter": "versionId",
      "identifier": "name",
      "allowedTypes": ["string", "date-time"]
    },
    {
      "parameter": "valueField",
      "inputParameter": "versionId",
      "identifier": "name",
      "allowedTypes": ["string", "number"]
    }
  ],
  "semanticRequirements": [
    {
      "kind": "fieldUnit",
      "inputParameter": "versionId",
      "fieldParameter": "valueField"
    },
    {
      "kind": "timeField",
      "inputParameter": "versionId",
      "fieldParameter": "timeField"
    },
    {
      "kind": "timeRange",
      "inputParameter": "versionId",
      "fieldParameter": "timeField",
      "startParameter": "expectedStart",
      "endParameter": "expectedEnd"
    },
    {
      "kind": "timeRange",
      "inputParameter": "versionId",
      "fieldParameter": "timeField",
      "startParameter": "baselineStart",
      "endParameter": "baselineEnd"
    },
    {
      "kind": "timeRange",
      "inputParameter": "versionId",
      "fieldParameter": "timeField",
      "startParameter": "comparisonStart",
      "endParameter": "comparisonEnd"
    }
  ],
  "defaultParameters": {
    "alpha": 0.05,
    "threshold": 3.5,
    "seasonalTrendEnabled": false,
    "thresholdEventsEnabled": false
  },
  "parameterBindings": {
    "groupField": "groupField",
    "timeField": "timeField",
    "valueField": "valueField",
    "frequency": "frequency",
    "expectedStart": "expectedStart",
