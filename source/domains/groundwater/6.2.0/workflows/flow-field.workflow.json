{
  "schemaVersion": "workflow.v6",
  "workflowId": "groundwater.flow-field",
  "version": "1.1.0",
  "inputs": [
    {
      "name": "observations",
      "cardinality": "one",
      "mediaTypes": ["text/csv", "application/vnd.apache.parquet", "application/vnd.apache.arrow.file"],
      "formats": ["csv", "parquet", "arrow-ipc-file"]
    }
  ],
  "parameters": ["wellField", "timeField", "valueField", "xField", "yField", "referenceElevationField", "depthToWaterField", "referenceElevationUnit", "depthToWaterUnit", "targetTime", "selection", "maxAgeDays", "sourceCrs", "targetCrs", "pixelSize", "power", "neighborCount", "hydraulicConductivityMetersPerDay", "effectivePorosity"],
  "nodes": [
    {
      "nodeId": "head", "operatorId": "groundwater.head.calculate", "operatorVersion": "1.0.0",
      "inputs": {"observations": {"workflowInput": "observations"}},
      "parameters": {
        "referenceElevationField": {"workflowParameter": "referenceElevationField"},
        "depthToWaterField": {"workflowParameter": "depthToWaterField"},
        "referenceElevationUnit": {"workflowParameter": "referenceElevationUnit"},
        "depthToWaterUnit": {"workflowParameter": "depthToWaterUnit"},
        "outputField": {"workflowParameter": "valueField"}
      }
    },
    {
      "nodeId": "snapshot", "operatorId": "timeseries.snapshot", "operatorVersion": "1.0.0",
      "inputs": {"observations": {"nodeOutput": {"nodeId": "head", "port": "heads"}}},
      "parameters": {
        "groupField": {"workflowParameter": "wellField"}, "timeField": {"workflowParameter": "timeField"},
        "valueField": {"workflowParameter": "valueField"}, "targetTime": {"workflowParameter": "targetTime"},
        "selection": {"workflowParameter": "selection"}, "maxAgeDays": {"workflowParameter": "maxAgeDays"}
      }
    },
    {
      "nodeId": "idw", "operatorId": "points.interpolate.idw", "operatorVersion": "1.0.0",
      "inputs": {"points": {"nodeOutput": {"nodeId": "snapshot", "port": "snapshot"}}},
      "parameters": {
        "valueField": {"workflowParameter": "valueField"}, "xField": {"workflowParameter": "xField"},
        "yField": {"workflowParameter": "yField"}, "sourceCrs": {"workflowParameter": "sourceCrs"},
        "targetCrs": {"workflowParameter": "targetCrs"}, "pixelSize": {"workflowParameter": "pixelSize"},
        "power": {"workflowParameter": "power"}, "neighborCount": {"workflowParameter": "neighborCount"}
      }
    },
    {
      "nodeId": "gradient", "operatorId": "groundwater.hydraulic_gradient", "operatorVersion": "1.0.0",
      "inputs": {"head": {"nodeOutput": {"nodeId": "idw", "port": "raster"}}},
      "parameters": {}
    },
    {
      "nodeId": "velocity", "operatorId": "groundwater.darcy_velocity", "operatorVersion": "1.0.0",
      "inputs": {
        "gradientMagnitude": {"nodeOutput": {"nodeId": "gradient", "port": "magnitude"}},
        "flowDirection": {"nodeOutput": {"nodeId": "gradient", "port": "direction"}}
      },
      "parameters": {
        "hydraulicConductivityMetersPerDay": {"workflowParameter": "hydraulicConductivityMetersPerDay"},
        "effectivePorosity": {"workflowParameter": "effectivePorosity"}
      }
    }
  ],
  "outputs": [
    {"name": "snapshot", "nodeOutput": {"nodeId": "snapshot", "port": "snapshot"}},
    {"name": "snapshot-diagnostics", "nodeOutput": {"nodeId": "snapshot", "port": "diagnostics"}},
    {"name": "head-raster", "nodeOutput": {"nodeId": "idw", "port": "raster"}},
    {"name": "gradient", "nodeOutput": {"nodeId": "gradient", "port": "magnitude"}},
    {"name": "flow-direction", "nodeOutput": {"nodeId": "gradient", "port": "direction"}},
    {"name": "darcy-flux", "nodeOutput": {"nodeId": "velocity", "port": "darcyFlux"}},
    {"name": "seepage-velocity", "nodeOutput": {"nodeId": "velocity", "port": "seepageVelocity"}},
    {"name": "summary", "nodeOutput": {"nodeId": "velocity", "port": "summary"}}
  ]
}
