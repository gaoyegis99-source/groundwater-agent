{
  "$defs": {
    "Input": {
      "additionalProperties": false,
      "properties": {
        "sizeBytes": {
          "exclusiveMinimum": 0,
          "maximum": 134217728,
          "title": "Sizebytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "mediaType": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mediatype",
          "type": "string"
        },
        "format": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "artifactId": {
          "pattern": "^artifact-[a-f0-9]{32}$",
          "title": "Artifactid",
          "type": "string"
        }
      },
      "required": [
        "sizeBytes",
        "sha256",
        "mediaType",
        "format",
        "artifactId"
      ],
      "title": "Input",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operationType": {
      "maxLength": 64,
      "title": "Operationtype",
      "type": "string",
      "enum": [
        "model.compile",
        "flow_transport.simulate",
        "result.analyze",
        "result.render",
        "scenario.compare",
        "map.prepare",
        "pest.calibrate",
        "inversion.train",
        "inversion.sample",
        "agri.invert"
      ]
    },
    "clientRequestId": {
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$",
      "title": "Clientrequestid",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/Input"
      },
      "title": "Inputs",
      "type": "object"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    }
  },
  "required": [
    "operationType",
    "clientRequestId",
    "inputs",
    "parameters"
  ],
