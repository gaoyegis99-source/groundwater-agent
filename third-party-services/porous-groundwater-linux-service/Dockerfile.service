FROM python:3.12.8-slim@sha256:2199a62885a12290dc9c5be3ca0681d367576ab7bf037da120e564723292a2f0
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock \
    && useradd --no-create-home --uid 10001 --shell /usr/sbin/nologin porous \
    && install -d -o porous -m 0700 /var/lib/porous-groundwater
RUN --network=none --mount=type=bind,source=wheels,target=/wheels \
    --mount=type=bind,source=requirements-science.lock,target=/tmp/requirements-science.lock \
    pip install --no-index --no-cache-dir --find-links=/wheels --require-hashes --no-deps \
    -r /tmp/requirements-science.lock && pip check
COPY porous_remote ./porous_remote
COPY vendor ./vendor
ENV POROUS_VENDOR_DIR=/app/vendor \
    POROUS_DATA_DIR=/var/lib/porous-groundwater \
    LD_LIBRARY_PATH=/app/vendor/lib \
    GDAL_DRIVER_PATH=disable PROJ_NETWORK=OFF \
    PYTHONDONTWRITEBYTECODE=1
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=5s --timeout=2s --retries=12 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/readyz', timeout=1)"
CMD ["python", "-m", "uvicorn", "porous_remote.api:app", "--host", "0.0.0.0", "--port", "8000"]
